//@version=5
indicator("imazecoin BUY_SALE_DCA Signals Pro", shorttitle="imazecoin B/S/D Signals Pro", overlay=true, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ── Moving Average Settings ──
maLength      = input.int(200, "MA Length", minval=1, group="Moving Average")
maType        = input.string("SMMA", "MA Type", options=["SMA", "EMA", "SMMA", "WMA", "HMA", "VWMA"], group="Moving Average")
maLineColor   = input.color(color.new(#00d4ff, 0), "MA Line Color", group="Moving Average")
maLineWidth   = input.int(2, "MA Line Width", minval=1, maxval=4, group="Moving Average")

// ── Background Fill Settings ──
fillAbove     = input.color(color.new(#00d4ff, 85), "Fill Above MA (Bullish)", group="Background Fill")
fillBelow     = input.color(color.new(#ff4757, 85), "Fill Below MA (Bearish)", group="Background Fill")
showFill      = input.bool(true, "Show Background Fill", group="Background Fill")

// ── Dashboard Settings ──
showDashboard = input.bool(true, "Show Dashboard", group="Dashboard")
dashPosition  = input.string("Middle Left", "Dashboard Position", options=["Top Right", "Top Left", "Middle Left", "Bottom Right", "Bottom Left"], group="Dashboard")
dashTextSize  = input.string("small", "Dashboard Text Size", options=["tiny", "small", "normal", "large"], group="Dashboard")

// ── Watermark Settings ──
showWatermark = input.bool(true, "Show Watermark", group="Watermark")
watermarkText = input.string("IMAZECOIN", "Watermark Text", group="Watermark")
watermarkColor= input.color(color.new(color.white, 85), "Watermark Color", group="Watermark", tooltip="Lower transparency value (e.g. 70) = more visible. Higher (e.g. 95) = subtle.")
watermarkSize = input.string("huge", "Watermark Size", options=["tiny", "small", "normal", "large", "huge"], group="Watermark")
wmOffsetBars  = input.int(15, "Watermark X offset (bars right of last candle)", minval=0, maxval=100, group="Watermark", tooltip="Position the watermark in the empty space to the RIGHT of the latest candle so candles do not cover it. 0 = at last candle (may overlap), 15-30 = recommended.")
wmVerticalPos = input.string("Middle", "Watermark Vertical Position", options=["Top", "Middle", "Bottom"], group="Watermark", tooltip="Vertical placement based on recent price range.")

// ── Signal Display Toggles (NEW) ──
showBuy   = input.bool(true, "Show BUY signals",  group="Signals: Display")
showSell  = input.bool(true, "Show SELL signals", group="Signals: Display")
showDCA   = input.bool(true, "Show DCA signals",  group="Signals: Display")
only1D    = input.bool(true, "Only show signals on 1D timeframe", group="Signals: Display")

// ── Signal Distance from MA (NEW) ──
buyDistPct  = input.float(15.0, "BUY: minimum percent BELOW MA",  minval=0.0, step=0.5, group="Signals: Distance from MA", tooltip="Increase for fewer (more extreme) BUY signals. Crypto: 25-35. Stocks/ETF: 10-15.")
sellDistPct = input.float(25.0, "SELL: minimum percent ABOVE MA", minval=0.0, step=0.5, group="Signals: Distance from MA", tooltip="Increase for fewer (more extreme) SELL signals. Crypto: 40-60. Stocks/ETF: 20-30.")

// ── Signal RSI Thresholds (NEW, reuse RSI 14 from dashboard) ──
rsiOversold   = input.int(30, "BUY: RSI must be BELOW",  minval=5,  maxval=50, group="Signals: RSI Thresholds", tooltip="Lower = fewer BUY signals (more extreme oversold required).")
rsiOverbought = input.int(72, "SELL: RSI must be ABOVE", minval=50, maxval=95, group="Signals: RSI Thresholds", tooltip="Higher = fewer SELL signals (more extreme overbought required).")
rsiDcaLow     = input.int(40, "DCA: RSI lower bound",    minval=10, maxval=50, group="Signals: RSI Thresholds")
rsiDcaHigh    = input.int(50, "DCA: RSI upper bound",    minval=40, maxval=70, group="Signals: RSI Thresholds")

// ── DCA Settings ──
dcaLookback = input.int(60,    "DCA lookback bars (recent high)", minval=5,            group="Signals: DCA", tooltip="How many bars back to look for the recent high.")
dcaDropPct  = input.float(12.0, "DCA: minimum percent drop from high", minval=1.0, step=0.5, group="Signals: DCA", tooltip="Minimum pullback from recent high. Higher = fewer DCA signals.")

// ── Signal Cooldown (applies to ALL signals equally) ──
signalCooldown = input.int(30, "Cooldown bars between same-type signals", minval=1, group="Signals: Cooldown", tooltip="Minimum 30 bars (days on 1D) between BUY-BUY, SELL-SELL, or DCA-DCA to avoid clustering.")

// ── Signal Style (NEW) ──
buyColor   = input.color(color.new(color.green, 0), "BUY label color",  group="Signals: Style")
sellColor  = input.color(color.new(color.red, 0),   "SELL label color", group="Signals: Style")
dcaColor   = input.color(color.new(color.blue, 0),  "DCA label color",  group="Signals: Style")
// Note: plotshape() requires a const string for size, so the label sizes are
// fixed (BUY/SELL = normal, DCA = small) instead of user-configurable.

// ══════════════════════════════════════════════════════════════════════════════
// MOVING AVERAGE CALCULATION
// ══════════════════════════════════════════════════════════════════════════════

maValue = switch maType
    "SMA"  => ta.sma(close, maLength)
    "EMA"  => ta.ema(close, maLength)
    "SMMA" => ta.rma(close, maLength)
    "WMA"  => ta.wma(close, maLength)
    "HMA"  => ta.hma(close, maLength)
    "VWMA" => ta.vwma(close, maLength)
    => ta.rma(close, maLength)

// ── Plot MA Line ──
maPlot = plot(maValue, "MA Line", color=maLineColor, linewidth=maLineWidth)

// ── Background Fill ──
fillColor = close > maValue ? fillAbove : fillBelow
p1 = plot(showFill ? close : na, "Close for Fill", color=na, editable=false)
fill(p1, maPlot, color=fillColor, title="MA Fill")

// ══════════════════════════════════════════════════════════════════════════════
// INDICATORS FOR DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

vwapV  = ta.vwap(hlc3)
rsiVal = ta.rsi(close, 14)
[m, s, _] = ta.macd(close, 12, 26, 9)
volAvg = ta.sma(volume, 20)

// ── Scores ──
float bScore = 0
bScore += (close > maValue ? 1 : 0)
bScore += (close > vwapV   ? 1 : 0)
bScore += (rsiVal > 50     ? 1 : 0)
bScore += (m > s           ? 1 : 0)
bScore += (volume > volAvg and close > open ? 1 : 0)
float bullPct = math.round((bScore / 5) * 100)

float rScore = 0
rScore += (close < maValue ? 1 : 0)
rScore += (close < vwapV   ? 1 : 0)
rScore += (rsiVal < 50     ? 1 : 0)
rScore += (m < s           ? 1 : 0)
rScore += (volume > volAvg and close < open ? 1 : 0)
float bearPct = math.round((rScore / 5) * 100)

// ── Market Bias ──
biasDiff = bullPct - bearPct
string biasText = biasDiff >= 60 ? "STRONG BULL" : biasDiff >= 20 ? "MILD BULL" : biasDiff <= -60 ? "STRONG BEAR" : biasDiff <= -20 ? "MILD BEAR" : "NEUTRAL"
color  biasCol  = str.contains(biasText, "BULL") ? color.green : str.contains(biasText, "BEAR") ? color.red : color.gray

// ══════════════════════════════════════════════════════════════════════════════
// LONG-TERM BUY / SELL / DCA SIGNALS  (NEW SECTION)
// Uses the user's configurable MA (maValue) and RSI(14) (rsiVal) above
// ══════════════════════════════════════════════════════════════════════════════

isAllowedTF  = only1D ? timeframe.isdaily : true
distFromMa   = (close - maValue) / maValue * 100.0
recentHigh   = ta.highest(high, dcaLookback)
dropFromHigh = (recentHigh - close) / recentHigh * 100.0

// Raw conditions
// BUY: only BELOW the MA (price must be under SMMA200)
buyRaw  = isAllowedTF and (close < maValue) and (distFromMa <= -buyDistPct) and (rsiVal <= rsiOversold)
// SELL: only ABOVE the MA (price must be over SMMA200)
sellRaw = isAllowedTF and (close > maValue) and (distFromMa >= sellDistPct) and (rsiVal >= rsiOverbought)
// DCA: only BELOW the MA (price must be under SMMA200)
dcaRaw  = isAllowedTF and (close < maValue) and (dropFromHigh >= dcaDropPct) and (rsiVal >= rsiDcaLow) and (rsiVal <= rsiDcaHigh) and (not buyRaw)

// Cooldown: 30 bars minimum between same-type signals (avoids clustering)
var int lastBuyBar  = na
var int lastSellBar = na
var int lastDcaBar  = na

buySignal  = buyRaw  and (na(lastBuyBar)  or (bar_index - lastBuyBar)  >= signalCooldown)
sellSignal = sellRaw and (na(lastSellBar) or (bar_index - lastSellBar) >= signalCooldown)
dcaSignal  = dcaRaw  and (na(lastDcaBar)  or (bar_index - lastDcaBar)  >= signalCooldown)

if buySignal
    lastBuyBar := bar_index
if sellSignal
    lastSellBar := bar_index
if dcaSignal
    lastDcaBar := bar_index

// Plot the signals as labels on the chart
// (plotshape size must be a const string, so we use fixed sizes here)
plotshape(showBuy  and buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=buyColor,  text="BUY",  textcolor=color.white, size=size.normal)
plotshape(showSell and sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=sellColor, text="SELL", textcolor=color.white, size=size.normal)
plotshape(showDCA  and dcaSignal,  title="DCA",  style=shape.labelup,   location=location.belowbar, color=dcaColor,  text="DCA",  textcolor=color.white, size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// WATERMARK
// Positioned in the empty space to the RIGHT of the last bar so that candles
// do not cover it. Vertically anchored using the recent 100-bar price range.
// ══════════════════════════════════════════════════════════════════════════════

wmSize = switch watermarkSize
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    "huge"   => size.huge
    => size.huge

// Compute Y position based on recent price range (so watermark sits in the
// visible area regardless of asset price scale).
wmRecentHigh = ta.highest(high, 100)
wmRecentLow  = ta.lowest(low,  100)
wmRange      = wmRecentHigh - wmRecentLow
wmY          = wmVerticalPos == "Top"    ? wmRecentHigh - wmRange * 0.10 :
               wmVerticalPos == "Bottom" ? wmRecentLow  + wmRange * 0.10 :
                                           (wmRecentHigh + wmRecentLow) / 2

if showWatermark and barstate.islast
    var label wmLabel = label.new(bar_index + wmOffsetBars, wmY, watermarkText,
         color=color.new(color.black, 100),
         textcolor=watermarkColor,
         style=label.style_none,
         size=wmSize,
         textalign=text.align_center)
    label.set_xy(wmLabel, bar_index + wmOffsetBars, wmY)
    label.set_text(wmLabel, watermarkText)

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

dashPos = switch dashPosition
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Middle Left"  => position.middle_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.middle_left

txtSize = switch dashTextSize
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.small

if showDashboard and barstate.islast
    dash = table.new(dashPos, 2, 9,
         bgcolor=color.new(color.black, 20),
         border_width=1,
         border_color=color.new(color.gray, 50))

    // ── Row 0: BULL SCORE ──
    table.cell(dash, 0, 0, "BULL SCORE",
         text_color=color.white, bgcolor=color.green,
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 0, str.tostring(bullPct) + "%",
         text_color=color.white, bgcolor=color.green,
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 1: BEAR SCORE ──
    table.cell(dash, 0, 1, "BEAR SCORE",
         text_color=color.white, bgcolor=color.red,
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.tostring(bearPct) + "%",
         text_color=color.white, bgcolor=color.red,
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 2: MARKET BIAS ──
    table.cell(dash, 0, 2, "MARKET BIAS",
         text_color=color.white, bgcolor=color.black,
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 2, biasText,
         text_color=color.white, bgcolor=biasCol,
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 3: Price / SMMA ──
    aboveBelow3 = close > maValue ? "ABOVE" : "BELOW"
    col3        = close > maValue ? color.green : color.red
    table.cell(dash, 0, 3, "Price/" + maType + str.tostring(maLength),
         text_color=color.white, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 3, aboveBelow3 + (close > maValue ? " ✅" : " ⚠️"),
         text_color=col3, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 4: Price / VWAP ──
    aboveBelow4 = close > vwapV ? "ABOVE" : "BELOW"
    col4        = close > vwapV ? color.green : color.red
    table.cell(dash, 0, 4, "Price/VWAP",
         text_color=color.white, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 4, aboveBelow4 + (close > vwapV ? " ✅" : " ⚠️"),
         text_color=col4, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 5: RSI ──
    rsiCol = rsiVal >= 70 ? color.red : rsiVal <= 30 ? color.green : color.white
    table.cell(dash, 0, 5, "RSI (14)",
         text_color=color.white, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 5, str.tostring(rsiVal, "#.#"),
         text_color=rsiCol, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 6: MACD Trend ──
    macdText = m > s ? "BULL" : "BEAR"
    macdCol  = m > s ? color.green : color.red
    table.cell(dash, 0, 6, "MACD Trend",
         text_color=color.white, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 6, macdText + (m > s ? " ✅" : " ⚠️"),
         text_color=macdCol, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 7: Volume ──
    volText = volume > volAvg ? "HIGH" : "LOW"
    volCol  = volume > volAvg ? color.green : color.gray
    table.cell(dash, 0, 7, "Volume",
         text_color=color.white, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 7, volText,
         text_color=volCol, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_right)

    // ── Row 8: Trend Str ──
    [_, _, adx] = ta.dmi(14, 14)
    trendText = adx > 25 ? "STRONG" : "WEAK"
    trendCol  = adx > 25 ? color.green : color.red
    table.cell(dash, 0, 8, "Trend Str",
         text_color=color.white, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, 8, trendText,
         text_color=trendCol, bgcolor=color.new(color.black, 60),
         text_size=txtSize, text_halign=text.align_right)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(ta.crossover(close, maValue),  "Price Cross Above MA", "Price crossed above MA")
alertcondition(ta.crossunder(close, maValue), "Price Cross Below MA", "Price crossed below MA")

// ── New signal alerts ──
alertcondition(buySignal,  "BUY signal",  "Long-term BUY signal")
alertcondition(sellSignal, "SELL signal", "Long-term SELL signal")
alertcondition(dcaSignal,  "DCA signal",  "DCA opportunity")
