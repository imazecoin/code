//@version=5
// Long-Term Buy / Sell / DCA Signals - 1D only
// For Stocks / ETFs / Crypto

indicator("Long-Term Buy / Sell / DCA Signals", shorttitle="LT B/S/DCA", overlay=true, max_labels_count=500)

// ----- Display toggles -----
showBuy  = input.bool(true, "Show BUY signals",  group="Display")
showSell = input.bool(true, "Show SELL signals", group="Display")
showDCA  = input.bool(true, "Show DCA signals",  group="Display")
showSMA  = input.bool(true, "Show SMA200 line",  group="Display")
showInfo = input.bool(true, "Show info panel",   group="Display")

// ----- Trend (SMA) settings -----
smaLength   = input.int(200,  "Long-term SMA length",        minval=20,  group="Trend (SMA)")
buyDistPct  = input.float(10.0, "BUY: minimum percent BELOW SMA",  minval=0.0, step=0.5, group="Trend (SMA)")
sellDistPct = input.float(20.0, "SELL: minimum percent ABOVE SMA", minval=0.0, step=0.5, group="Trend (SMA)")

// ----- RSI settings -----
rsiLength     = input.int(14, "RSI length",                  minval=2,             group="Momentum (RSI)")
rsiOversold   = input.int(32, "BUY: RSI must be BELOW",      minval=5,  maxval=50, group="Momentum (RSI)")
rsiOverbought = input.int(70, "SELL: RSI must be ABOVE",     minval=50, maxval=95, group="Momentum (RSI)")
rsiDcaLow     = input.int(38, "DCA: RSI lower bound",        minval=10, maxval=50, group="Momentum (RSI)")
rsiDcaHigh    = input.int(55, "DCA: RSI upper bound",        minval=40, maxval=70, group="Momentum (RSI)")

// ----- DCA settings -----
dcaLookback = input.int(40,    "DCA lookback bars (recent high)",   minval=5,            group="DCA")
dcaDropPct  = input.float(8.0, "DCA: minimum percent drop from high", minval=1.0, step=0.5, group="DCA")
dcaCooldown = input.int(7,     "DCA cooldown (bars)",               minval=1,            group="DCA")

// ----- Timeframe guard -----
isDaily = timeframe.isdaily

// ----- Calculations -----
sma          = ta.sma(close, smaLength)
rsi          = ta.rsi(close, rsiLength)
recentHigh   = ta.highest(high, dcaLookback)
distFromSma  = (close - sma) / sma * 100.0
dropFromHigh = (recentHigh - close) / recentHigh * 100.0
smaRising    = sma > sma[5]

// ----- Raw conditions -----
buyRaw  = isDaily and (distFromSma <= -buyDistPct) and (rsi <= rsiOversold)
sellRaw = isDaily and (distFromSma >=  sellDistPct) and (rsi >= rsiOverbought)
dcaRaw  = isDaily and (dropFromHigh >= dcaDropPct) and (rsi >= rsiDcaLow) and (rsi <= rsiDcaHigh) and smaRising and (not buyRaw)

// ----- Cooldown / debounce -----
var int lastBuyBar  = na
var int lastSellBar = na
var int lastDcaBar  = na

buySignal  = buyRaw  and (na(lastBuyBar)  or (bar_index - lastBuyBar)  >= 5)
sellSignal = sellRaw and (na(lastSellBar) or (bar_index - lastSellBar) >= 5)
dcaSignal  = dcaRaw  and (na(lastDcaBar)  or (bar_index - lastDcaBar)  >= dcaCooldown)

if buySignal
    lastBuyBar := bar_index
if sellSignal
    lastSellBar := bar_index
if dcaSignal
    lastDcaBar := bar_index

// ----- Plotting -----
plot(showSMA ? sma : na, "SMA200", color=color.new(color.orange, 0), linewidth=2)

plotshape(showBuy  and buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.normal)
plotshape(showSell and sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   text="SELL", textcolor=color.white, size=size.normal)
plotshape(showDCA  and dcaSignal,  title="DCA",  style=shape.labelup,   location=location.belowbar, color=color.new(color.blue, 0),  text="DCA",  textcolor=color.white, size=size.small)

bgcolor(showBuy  and buyRaw  ? color.new(color.green, 90) : na, title="BUY zone")
bgcolor(showSell and sellRaw ? color.new(color.red,   90) : na, title="SELL zone")

// ----- Alerts -----
alertcondition(buySignal,  title="BUY signal",  message="Long-term BUY signal")
alertcondition(sellSignal, title="SELL signal", message="Long-term SELL signal")
alertcondition(dcaSignal,  title="DCA signal",  message="DCA opportunity")

// ----- Info panel + timeframe warning -----
var table info = table.new(position.top_right, 2, 5, border_width=1, frame_color=color.gray, frame_width=1)

if barstate.islast and showInfo
    tfTxt  = isDaily ? "1D OK" : "NOT 1D"
    tfCol  = isDaily ? color.new(color.green, 60) : color.new(color.red, 30)
    zoneTxt = buyRaw ? "BUY zone" : sellRaw ? "SELL zone" : dcaRaw ? "DCA zone" : "Neutral"
    zoneCol = buyRaw ? color.new(color.green, 30) : sellRaw ? color.new(color.red, 30) : dcaRaw ? color.new(color.blue, 30) : color.new(color.gray, 50)

    table.cell(info, 0, 0, "Timeframe",       bgcolor=color.new(color.gray, 70),  text_color=color.white)
    table.cell(info, 1, 0, tfTxt,             bgcolor=tfCol,                      text_color=color.white)
    table.cell(info, 0, 1, "Price vs SMA200", bgcolor=color.new(color.gray, 70),  text_color=color.white)
    table.cell(info, 1, 1, str.tostring(distFromSma, "#.##") + " %", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(info, 0, 2, "RSI",             bgcolor=color.new(color.gray, 70),  text_color=color.white)
    table.cell(info, 1, 2, str.tostring(rsi, "#.##"),                bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(info, 0, 3, "Drop from high",  bgcolor=color.new(color.gray, 70),  text_color=color.white)
    table.cell(info, 1, 3, str.tostring(dropFromHigh, "#.##") + " %",bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(info, 0, 4, "Current zone",    bgcolor=color.new(color.gray, 70),  text_color=color.white)
    table.cell(info, 1, 4, zoneTxt,           bgcolor=zoneCol,                    text_color=color.white)

if barstate.islast and (not isDaily)
    label.new(bar_index, high, text="Use 1D timeframe", color=color.new(color.red, 10), textcolor=color.white, style=label.style_label_down, size=size.normal)
